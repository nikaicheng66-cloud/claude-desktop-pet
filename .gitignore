# Xiaoke (claude-desktop-pet) top-level repository: wechat_auto, launcher, agent, remote and the other parts without a repository of their own.

# These two folders are git repositories of their own
/Open-LLM-VTuber/
/Open-LLM-VTuber-Web/

# Third-party and large
/GPT-SoVITS-*/
/installers/

# What she produces while running, and private data
/audio_notes/
/agent/reports/
/agent/screen/
/agent/pictures/
/agent/intent_log.jsonl
/agent/cloud_usage.json
/wechat_auto/state/
/wechat_auto/samples/

# Secrets
/remote/token.txt

# Logs and caches
*.log
/launcher/progress.txt
__pycache__/
*.pyc

# assets: text and scripts only, no audio, images or art source files
/assets/**/*.wav
/assets/**/*.mp3
/assets/**/*.png
/assets/**/*.psd
/assets/**/*.cmo3

# backups holds hand-made copies of old files: only the tests are kept
/backups/*/*
!/backups/*/tests/

# Created on your own PC, not published
/outside/startup/
/outside/desktop/
/outside/shortcuts.txt
/wechat_auto/target_name.npy
/backups/*/tests/*.jsonl
