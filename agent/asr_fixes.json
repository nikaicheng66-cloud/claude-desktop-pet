  "cloud ?code|克劳德 ?code|claude ?扣的": "Claude Code",
  "插掉": "叉掉",
  "微 ?信": "微信",
  "你(先|去)?消息(吧|一下|一会儿?)": "你\\1休息\\2",
  "(去|先|好好)消息吧": "\\1休息吧",
  "(先|别|不要)(别)?洗脚": "\\1\\2提交",
  "先安心": "先暂停",
  "小课|小柯|小科": "小克"
}